# ---------------------------------------------------------------------------
# muse-ician — optional server-side configuration
#
# Everything below is OPTIONAL. The app works offline with no provider at all:
# preset library, ideas, coaching rubric, metadata templates, calendar,
# performance journal and JSON import/export all run in the browser.
#
# These variables are read ONLY by the serverless functions in /api.
# Never put a secret in a VITE_* variable: Vite inlines those into the client
# bundle, where anyone can read them.
#
# Copy to `.env` for `vercel dev` or set them in your Vercel project settings.
# ---------------------------------------------------------------------------

# --- AI provider (used by /api/ai) -----------------------------------------
# openai | openai-compatible | anthropic | mock
# `mock` returns deterministic placeholder data and is treated as an error by
# the UI — it exists so you can verify wiring, never to pretend AI worked.
AI_PROVIDER=
AI_API_KEY=
# Optional. Defaults are used when unset.
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=60000

# --- Trend provider (used by /api/trends) ----------------------------------
# A permitted source you have the right to query. Without it the app shows
# evergreen guidance and never invents trending sounds, hashtags or formats.
TREND_PROVIDER_URL=
TREND_PROVIDER_NAME=
TREND_PROVIDER_TOKEN=
