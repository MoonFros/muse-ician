{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse-ician.app/schema/1.0.0/muse-ician.schema.json",
  "title": "muse-ician import/export format",
  "description": "Versioned interchange format for muse-ician. An export file always carries schema_version, export_type and a manifest. Records reference each other by stable id. Unknown fields are ignored with a warning; invalid records are rejected individually so that one bad record never destroys an import.",
  "type": "object",
  "required": [
    "schema_version",
    "export_type",
    "manifest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of this schema. The app supports 1.x."
    },
    "export_type": {
      "type": "string",
      "enum": [
        "preset_pack",
        "campaign_plan",
        "metadata_package",
        "workspace_backup",
        "single_preset",
        "performance_snapshot"
      ]
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "preferences": {
      "anyOf": [
        {
          "$ref": "#/$defs/preferences"
        },
        {
          "type": "null"
        }
      ]
    },
    "presets": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/preset"
      }
    },
    "songs": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/song"
      }
    },
    "content_ideas": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/content_idea"
      }
    },
    "metadata_packages": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/metadata_package"
      }
    },
    "campaigns": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/campaign"
      }
    },
    "planned_posts": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/planned_post"
      }
    },
    "trends": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/trend_record"
      }
    },
    "performance_records": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/performance_record"
      }
    }
  },
  "$defs": {
    "isodate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "nullableIsodate": {
      "anyOf": [
        {
          "$ref": "#/$defs/isodate"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20000
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "maxLength": 20000
    },
    "stringArray": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000
    },
    "platform": {
      "enum": [
        "youtube-shorts",
        "instagram-reels",
        "tiktok"
      ]
    },
    "objective": {
      "enum": [
        "discovery",
        "song-promotion",
        "audience-engagement",
        "community-building",
        "storytelling",
        "artist-identity",
        "education",
        "behind-the-scenes",
        "trend-participation",
        "feedback-gathering"
      ]
    },
    "difficulty": {
      "enum": [
        "easy",
        "moderate",
        "challenging"
      ]
    },
    "budget": {
      "enum": [
        "minimal",
        "low",
        "moderate",
        "high"
      ]
    },
    "filming_method": {
      "enum": [
        "live-action",
        "animation",
        "screen-recording",
        "archival-footage",
        "static-text",
        "hybrid"
      ]
    },
    "face_visibility": {
      "enum": [
        "required",
        "optional",
        "none"
      ]
    },
    "campaign_stage": {
      "enum": [
        "pre-release",
        "release-week",
        "post-release",
        "evergreen"
      ]
    },
    "workflow_status": {
      "enum": [
        "idea",
        "planning",
        "scripted",
        "filming",
        "editing",
        "ready-to-publish",
        "published",
        "reviewed",
        "archived"
      ]
    },
    "release_status": {
      "enum": [
        "unreleased",
        "upcoming",
        "released",
        "archived"
      ]
    },
    "tone": {
      "enum": [
        "conversational",
        "funny",
        "mysterious",
        "emotional",
        "cinematic",
        "direct",
        "minimal",
        "storytelling"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "manifest": {
      "type": "object",
      "required": [
        "name",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "created_at": {
          "$ref": "#/$defs/isodate"
        },
        "author": {
          "$ref": "#/$defs/nullableString"
        },
        "schema_version": {
          "type": "string"
        },
        "exported_by": {
          "$ref": "#/$defs/nullableString"
        },
        "record_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "duration_range": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "audio_section": {
      "type": "object",
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/shortString"
        },
        "timestamp": {
          "$ref": "#/$defs/nullableString"
        },
        "note": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "example_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": {
          "anyOf": [
            {
              "$ref": "#/$defs/tone"
            },
            {
              "type": "null"
            }
          ]
        },
        "caption_example": {
          "$ref": "#/$defs/nullableString"
        },
        "title_example": {
          "$ref": "#/$defs/nullableString"
        },
        "hashtag_examples": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "preset": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "description",
        "objectives",
        "platforms",
        "duration_seconds",
        "difficulty",
        "budget",
        "filming_methods",
        "face_visibility",
        "equipment",
        "tags",
        "hook_examples",
        "execution_steps",
        "shot_list",
        "cta_examples"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/shortString"
        },
        "title": {
          "$ref": "#/$defs/shortString"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/objective"
          }
        },
        "secondary_objectives": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/objective"
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/platform"
          }
        },
        "duration_seconds": {
          "$ref": "#/$defs/duration_range"
        },
        "difficulty": {
          "$ref": "#/$defs/difficulty"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "filming_methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/filming_method"
          }
        },
        "face_visibility": {
          "$ref": "#/$defs/face_visibility"
        },
        "equipment": {
          "$ref": "#/$defs/stringArray"
        },
        "tags": {
          "$ref": "#/$defs/stringArray"
        },
        "genre_tags": {
          "$ref": "#/$defs/stringArray"
        },
        "mood_tags": {
          "$ref": "#/$defs/stringArray"
        },
        "campaign_stage": {
          "$ref": "#/$defs/campaign_stage"
        },
        "song_context_required": {
          "$ref": "#/$defs/nullableString"
        },
        "hook_examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "execution_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "shot_list": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "on_screen_text": {
          "$ref": "#/$defs/stringArray"
        },
        "audio_guidance": {
          "$ref": "#/$defs/nullableString"
        },
        "editing_notes": {
          "$ref": "#/$defs/nullableString"
        },
        "cta_examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "variations": {
          "$ref": "#/$defs/stringArray"
        },
        "common_mistakes": {
          "$ref": "#/$defs/stringArray"
        },
        "accessibility_notes": {
          "$ref": "#/$defs/nullableString"
        },
        "example_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/example_metadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_production_minutes": {
          "$ref": "#/$defs/nullableInteger"
        },
        "is_favorite": {
          "type": "boolean"
        },
        "is_user_created": {
          "type": "boolean"
        },
        "is_archived": {
          "type": "boolean"
        },
        "source_preset_id": {
          "$ref": "#/$defs/nullableString"
        },
        "usage_count": {
          "type": "integer",
          "minimum": 0
        },
        "is_demo": {
          "type": "boolean"
        },
        "custom_note": {
          "$ref": "#/$defs/nullableString"
        },
        "created_at": {
          "$ref": "#/$defs/isodate"
        },
        "updated_at": {
          "$ref": "#/$defs/isodate"
        },
        "schema_version": {
          "type": "string"
        },
        "preset_version": {
          "type": "string"
        }
      }
    },
    "song": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/shortString"
        },
        "title": {
          "$ref": "#/$defs/shortString"
        },
        "artist": {
          "$ref": "#/$defs/nullableString"
        },
        "genre": {
          "$ref": "#/$defs/nullableString"
        },
        "subgenre": {
          "$ref": "#/$defs/nullableString"
        },
        "moods": {
          "$ref": "#/$defs/stringArray"
        },
        "language": {
          "$ref": "#/$defs/nullableString"
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "lyrics": {
          "$ref": "#/$defs/nullableString"
        },
        "themes": {
          "$ref": "#/$defs/stringArray"
        },
        "target_audience": {
          "$ref": "#/$defs/nullableString"
        },
        "intended_listener_response": {
          "$ref": "#/$defs/nullableString"
        },
        "strongest_lyrics": {
          "$ref": "#/$defs/stringArray"
        },
        "audio_sections": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/audio_section"
          }
        },
        "bpm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 20,
              "maximum": 400
            },
            {
              "type": "null"
            }
          ]
        },
        "musical_key": {
          "$ref": "#/$defs/nullableString"
        },
        "release_status": {
          "$ref": "#/$defs/release_status"
        },
        "release_date": {
          "$ref": "#/$defs/nullableIsodate"
        },
        "cover_art_ref": {
          "$ref": "#/$defs/nullableString"
        },
        "streaming_url": {
          "$ref": "#/$defs/nullableString"
        },
        "music_video_url": {
          "$ref": "#/$defs/nullableString"
        },
        "persona_notes": {
          "$ref": "#/$defs/nullableString"
        },
        "visual_identity_notes": {
          "$ref": "#/$defs/nullableString"
        },
        "production_constraints": {
          "$ref": "#/$defs/nullableString"
        },
        "equipment": {
          "$ref": "#/$defs/stringArray"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/budget"
            },
            {
              "type": "null"
            }
          ]
        },
        "filming_locations": {
          "$ref": "#/$defs/stringArray"
        },
        "face_visibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/face_visibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "animation_capability": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "posting_frequency": {
          "$ref": "#/$defs/nullableString"
        },
        "campaign_notes": {
          "$ref": "#/$defs/nullableString"
        },
        "is_demo": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "#/$defs/isodate"
        },
        "updated_at": {
          "$ref": "#/$defs/isodate"
        },
        "schema_version": {
          "type": "string"
        }
      }
    },
    "rubric_component": {
      "type": "object",
      "required": [
        "key",
        "label",
        "score",
        "weight",
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "hook",
            "song_fit",
            "audience",
            "visual_progression",
            "feasibility",
            "distinctiveness"
          ]
        },
        "label": {
          "$ref": "#/$defs/shortString"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "explanation": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "score",
        "confidence",
        "components",
        "rubric_version",
        "disclaimer"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "components": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/rubric_component"
          }
        },
        "rubric_version": {
          "type": "string"
        },
        "disclaimer": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "improvement": {
      "type": "object",
      "required": [
        "area",
        "suggestion",
        "impact"
      ],
      "additionalProperties": false,
      "properties": {
        "area": {
          "$ref": "#/$defs/shortString"
        },
        "suggestion": {
          "$ref": "#/$defs/text"
        },
        "impact": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "coach_assessment": {
      "type": "object",
      "required": [
        "summary",
        "strengths",
        "weaknesses",
        "hook_assessment",
        "song_fit",
        "audience_fit",
        "feasibility",
        "pacing_suggestions",
        "improvements",
        "revised_concept",
        "recommended_platforms",
        "next_steps",
        "readiness",
        "source",
        "generated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/text"
        },
        "strengths": {
          "$ref": "#/$defs/stringArray"
        },
        "weaknesses": {
          "$ref": "#/$defs/stringArray"
        },
        "hook_assessment": {
          "$ref": "#/$defs/text"
        },
        "song_fit": {
          "$ref": "#/$defs/text"
        },
        "audience_fit": {
          "$ref": "#/$defs/text"
        },
        "feasibility": {
          "$ref": "#/$defs/text"
        },
        "pacing_suggestions": {
          "$ref": "#/$defs/stringArray"
        },
        "improvements": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/improvement"
          }
        },
        "revised_concept": {
          "$ref": "#/$defs/text"
        },
        "alternative_concept": {
          "$ref": "#/$defs/nullableString"
        },
        "recommended_platforms": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "platform",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "platform": {
                "$ref": "#/$defs/platform"
              },
              "reason": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "next_steps": {
          "$ref": "#/$defs/stringArray"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "source": {
          "enum": [
            "ai",
            "local-heuristic"
          ]
        },
        "generated_at": {
          "$ref": "#/$defs/isodate"
        }
      }
    },
    "idea_snapshot": {
      "type": "object",
      "required": [
        "title",
        "concept_description",
        "hook",
        "scene_sequence",
        "shot_list",
        "on_screen_text",
        "editing_notes",
        "call_to_action",
        "audio_section"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "concept_description": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        },
        "scene_sequence": {
          "$ref": "#/$defs/stringArray"
        },
        "shot_list": {
          "$ref": "#/$defs/stringArray"
        },
        "on_screen_text": {
          "$ref": "#/$defs/stringArray"
        },
        "editing_notes": {
          "type": "string"
        },
        "call_to_action": {
          "type": "string"
        },
        "audio_section": {
          "type": "string"
        }
      }
    },
    "idea_version": {
      "type": "object",
      "required": [
        "id",
        "label",
        "created_at",
        "snapshot"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/shortString"
        },
        "label": {
          "$ref": "#/$defs/shortString"
        },
        "created_at": {
          "$ref": "#/$defs/isodate"
        },
        "snapshot": {
          "$ref": "#/$defs/idea_snapshot"
        },
        "readiness_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "readiness_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "local-heuristic",
            "ai",
            null
          ]
        }
      }
    },
    "content_idea": {
      "type": "object",
      "required": [
        "id",
        "title",
        "concept_description",
        "status",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/shortString"
        },
        "title": {
          "$ref": "#/$defs/shortString"
        },
        "song_id": {
          "$ref": "#/$defs/nullableString"
        },
        "source_preset_id": {
          "$ref": "#/$defs/nullableString"
        },
        "mode": {
          "enum": [
            "use-as-is",
            "customized",
            "from-scratch"
          ]
        },
        "concept_description": {
          "$ref": "#/$defs/text"
        },
        "hook": {
          "type": "string",
          "maxLength": 2000
        },
        "intended_audience": {
          "$ref": "#/$defs/nullableString"
        },
        "scene_sequence": {
          "$ref": "#/$defs/stringArray"
        },
        "shot_list": {
          "$ref": "#/$defs/stringArray"
